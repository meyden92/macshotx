{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate Project",
      "detail": "Run XcodeGen to regenerate macshot.xcodeproj from project.yml",
      "type": "shell",
      "command": "xcodegen generate",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build",
      "detail": "xcodebuild Debug build",
      "type": "shell",
      "command": "xcodebuild -project macshot.xcodeproj -scheme macshot -configuration Debug build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "Test",
      "detail": "xcodebuild test",
      "type": "shell",
      "command": "xcodebuild -project macshot.xcodeproj -scheme macshot test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "Clean",
      "detail": "xcodebuild clean",
      "type": "shell",
      "command": "xcodebuild -project macshot.xcodeproj -scheme macshot clean",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
